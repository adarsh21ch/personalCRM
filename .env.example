# Copy to .env and fill in. Never commit .env.

# --- data. Both set -> Supabase Postgres. Unset -> local SQLite (see CRM_DB).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=        # service_role key. Bypasses RLS. Server only, never a browser.
CRM_DB=data/crm.db           # SQLite path, used only when Supabase is unset.
# Every table this app creates/reads is prefixed crm_ (crm_clients, crm_payments,
# ...) so it can live inside a Supabase project shared with other tools without
# colliding with their tables. Change the prefix only if you need a second,
# independent instance of this app in the SAME project - and if you do, run
# supabase/migrations/0001_init.sql edited to match before starting the app.
CRM_TABLE_PREFIX=crm_

# --- who can sign in to /admin. All three, or sign-in refuses outright.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=         # PBKDF2, never the password itself. See app/auth.py's docstring
                              # for the one-line command that generates this.
ADMIN_SECRET=                # signs the admin session cookie

# --- encrypts every secret you enter at /admin/settings (Razorpay, WhatsApp,
# email, AI keys). If unset, ADMIN_SECRET is used instead, which ties the two
# lifetimes together - rotating ADMIN_SECRET to sign yourself out would also
# make the stored secrets unreadable. Set this separately.
SETTINGS_KEY=

# Everything else - Razorpay keys, WhatsApp/Twilio, Resend/Gmail, AI provider
# keys, your business name - is entered from /admin/settings after the first
# deploy. There is nothing else to put in this file.
